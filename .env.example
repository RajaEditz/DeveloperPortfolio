# ==========================================
# FRONTEND CONFIGURATION (Vite)
# ==========================================
VITE_API_URL=https://your-backend-app.onrender.com/api

# ==========================================
# BACKEND CONFIGURATION (Express & PG)
# ==========================================
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-portfolio-app.vercel.app

# PostgreSQL connection string (Neon Postgres or standard PG)
# Note: append ?sslmode=require for Neon in production
DATABASE_URL=postgresql://user:password@ep-host-name.neon.tech/dbname?sslmode=require

# JWT authentication secret key
JWT_SECRET=generate_a_long_random_jwt_secret_string

# Default Administrator Credentials (for login)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ==========================================
# CLOUDINARY CONFIGURATION (Asset uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
